<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Storage permissions for older Android versions -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" 
        android:maxSdkVersion="29" />
    
    <!-- Android 11+ Storage -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" 
        tools:ignore="ScopedStorage" />
    
    <!-- Android 13+ Granular Media Permissions -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    
    <!-- Android 14+ Photo Picker Permission -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    
    <!-- Document Access -->
    <uses-permission android:name="android.permission.MANAGE_DOCUMENTS" />
    
    <!-- Audio recording and playback -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- Notification permissions for Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- Foreground service permissions for API 34+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name=".CleverFerretApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CleverFerretMediaLibrary"
        android:requestLegacyExternalStorage="true"
        android:preserveLegacyExternalStorage="true">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            
            <!-- File Type Associations for EPUB -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="application/epub+zip" />
            </intent-filter>
            
            <!-- File Type Associations for PDF -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
        
        <!-- Additional file associations merged into the primary MainActivity above -->
        <service
            android:name=".services.CalibreImportForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service 
            android:name=".services.audio.MusicPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <service
            android:name=".services.MediaScannerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        
        <!-- Media Playback Widget -->
        <receiver
            android:name=".widgets.MediaPlaybackWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/media_playback_widget_info" />
        </receiver>
        
        <!-- Music Player Widget -->
        <receiver
            android:name=".widgets.MusicPlayerWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.universalmedialibrary.MUSIC_PLAY_PAUSE" />
                <action android:name="com.universalmedialibrary.MUSIC_NEXT" />
                <action android:name="com.universalmedialibrary.MUSIC_PREV" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_music_player_info" />
        </receiver>
        
        <!-- Audiobook Player Widget -->
        <receiver
            android:name=".widgets.AudiobookPlayerWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.universalmedialibrary.AUDIOBOOK_PLAY_PAUSE" />
                <action android:name="com.universalmedialibrary.AUDIOBOOK_REWIND" />
                <action android:name="com.universalmedialibrary.AUDIOBOOK_FORWARD" />
                <action android:name="com.universalmedialibrary.AUDIOBOOK_SPEED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_audiobook_player_info" />
        </receiver>
        
        <!-- Radio Player Widget -->
        <receiver
            android:name=".widgets.RadioPlayerWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.universalmedialibrary.RADIO_PLAY_PAUSE" />
                <action android:name="com.universalmedialibrary.RADIO_NEXT" />
                <action android:name="com.universalmedialibrary.RADIO_PREV" />
                <action android:name="com.universalmedialibrary.RADIO_FAVORITE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_radio_player_info" />
        </receiver>
        
        <!-- Podcast Player Widget -->
        <receiver
            android:name=".widgets.PodcastPlayerWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.universalmedialibrary.PODCAST_PLAY_PAUSE" />
                <action android:name="com.universalmedialibrary.PODCAST_REWIND" />
                <action android:name="com.universalmedialibrary.PODCAST_FORWARD" />
                <action android:name="com.universalmedialibrary.PODCAST_SPEED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_podcast_player_info" />
        </receiver>
        
        <!-- Text-to-Speech Widget -->
        <receiver
            android:name=".widgets.TextToSpeechWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.universalmedialibrary.TTS_PLAY_PAUSE" />
                <action android:name="com.universalmedialibrary.TTS_PREV" />
                <action android:name="com.universalmedialibrary.TTS_NEXT" />
                <action android:name="com.universalmedialibrary.TTS_SPEED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tts_player_info" />
        </receiver>
        
        <!-- Comic Reader Widget -->
        <receiver
            android:name=".widgets.ComicReaderWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_comic_reader_info" />
        </receiver>
        
        <!-- Video Player Widget -->
        <receiver
            android:name=".widgets.VideoPlayerWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_video_player_info" />
        </receiver>
        
        <!-- Currently Reading Widget -->
        <receiver
            android:name=".widgets.CurrentlyReadingWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_currently_reading_info" />
        </receiver>
        
        <!-- Quick Access Widget -->
        <receiver
            android:name=".widgets.QuickAccessWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_access_info" />
        </receiver>
        
        <!-- Reading Stats Widget -->
        <receiver
            android:name=".widgets.ReadingStatsWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_reading_stats_info" />
        </receiver>
        
        <!-- Reading Goal Widget -->
        <receiver
            android:name=".widgets.ReadingGoalWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_reading_goal_info" />
        </receiver>
        
        <!-- File Provider for sharing files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
