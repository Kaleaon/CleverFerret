# CleverFerret Gradle Properties - Docker Build Optimized
# This configuration includes all permanent fixes for reliable builds

# This property is required for any modern Android project using AndroidX.
android.useAndroidX=true

# This property is recommended for better build performance and correctness.
android.nonTransitiveRClass=true

# PERMANENT FIX: Optimized Gradle configuration for CleverFerret
# Memory allocation optimized for Docker containers and CI/CD environments
org.gradle.jvmargs=-Xmx6144m -XX:MaxMetaspaceSize=2g -XX:+UseG1GC -XX:+HeapDumpOnOutOfMemoryError -XX:+UseStringDeduplication

# Performance optimizations
org.gradle.parallel=true
org.gradle.caching=true
org.gradle.configureondemand=true
org.gradle.daemon=false

# Android build optimizations
android.enableJetifier=true
android.incremental=true
android.builder.sdkDownload=false
android.enableBuildCache=true

# PERMANENT FIX: Prevent common build issues
android.useAndroidX=true
android.enableJetifier=true

# R8/ProGuard optimizations
android.enableR8=true
android.enableR8.fullMode=true

# Build performance improvements
org.gradle.vfs.watch=false
org.gradle.unsafe.configuration-cache=false