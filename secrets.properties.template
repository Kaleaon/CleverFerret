# CleverFerret Secrets Configuration
# 
# This file contains sensitive API keys and credentials.
# DO NOT commit this file to version control!
# 
# Copy this file to secrets.properties and fill in your actual values.

# TasteDive API Key
# Get your key from: https://tastedive.com/account/api_access
TASTEDIVE_API_KEY=your_tastedive_api_key_here

# OpenAI API Key (for AI features)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google API Key (for cloud sync, if needed)
GOOGLE_API_KEY=your_google_api_key_here

# Dropbox API Key (for cloud sync, if needed)
DROPBOX_API_KEY=your_dropbox_api_key_here

# Plex API Key (for Plex integration, if needed)
PLEX_API_KEY=your_plex_api_key_here

# Freesound API Key (for sound effects)
# Get your key from: https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=your_freesound_api_key_here
