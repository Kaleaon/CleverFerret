{
  "name": "CleverFerret Universal Media Library",
  "description": "GitHub Copilot configuration for CleverFerret Android project with Universal Build System",
  
  "project_info": {
    "type": "android-kotlin",
    "architecture": "MVVM",
    "ui_framework": "jetpack-compose",
    "dependency_injection": "hilt",
    "database": "room",
    "media_framework": "media3-exoplayer"
  },
  
  "copilot_settings": {
    "language_preferences": ["kotlin", "java", "xml"],
    "framework_context": [
      "jetpack-compose",
      "android-architecture-components",
      "material-design-3",
      "room-database",
      "hilt-dependency-injection"
    ],
    "code_style": "kotlin-official"
  },
  
  "intelligent_suggestions": {
    "patterns": [
      {
        "pattern": "compose-ui",
        "context": "When working in ui/ package, suggest Jetpack Compose patterns",
        "examples": ["@Composable functions", "Material 3 components", "state management"]
      },
      {
        "pattern": "room-database",
        "context": "When working in data/ package, suggest Room database patterns",
        "examples": ["@Entity classes", "@Dao interfaces", "database migrations"]
      },
      {
        "pattern": "hilt-di",
        "context": "When working with dependency injection, suggest Hilt patterns",
        "examples": ["@Module classes", "@Provides methods", "@Inject constructors"]
      },
      {
        "pattern": "media-player",
        "context": "When working with media playback, suggest Media3 ExoPlayer patterns",
        "examples": ["ExoPlayer setup", "MediaItem creation", "playback state management"]
      }
    ]
  },
  
  "build_system_awareness": {
    "type": "universal-build-system",
    "build_commands": [
      "./build-scripts/simple-build.sh build debug",
      "./build-scripts/universal-build.sh info",
      "./gradlew testDebugUnitTest"
    ],
    "architecture_detection": "automatic",
    "multi_arch_support": ["arm64-v8a", "x86_64", "armeabi-v7a", "x86"]
  },
  
  "context_files": [
    "README.md",
    "docs/BUILD_SYSTEM.md",
    "CleverFerret/src/main/java/**/*.kt",
    "CleverFerret/build.gradle.kts",
    "build.gradle.kts"
  ],
  
  "exclude_from_suggestions": [
    "build/",
    ".gradle/",
    "android-tools/build/",
    "*.apk",
    "*.aab"
  ],
  
  "custom_completions": {
    "build_commands": {
      "simple_build": "./build-scripts/simple-build.sh build",
      "universal_info": "./build-scripts/universal-build.sh info",
      "diagnose": "./gradlew diagnose",
      "arch_info": "./gradlew architectureInfo"
    },
    "common_imports": [
      "androidx.compose.runtime.*",
      "androidx.compose.ui.*",
      "androidx.compose.material3.*",
      "androidx.room.*",
      "dagger.hilt.android.*",
      "androidx.media3.exoplayer.*"
    ]
  }
}