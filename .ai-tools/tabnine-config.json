{
  "project_metadata": {
    "name": "CleverFerret Universal Media Library",
    "type": "android-kotlin",
    "framework": "jetpack-compose",
    "architecture": "mvvm-hilt"
  },
  
  "tabnine_preferences": {
    "model_type": "pro",
    "language_support": ["kotlin", "java", "xml", "gradle-kotlin-dsl"],
    "completion_style": "context-aware",
    "team_training": {
      "patterns": [
        "jetpack-compose-ui",
        "room-database-operations", 
        "hilt-dependency-injection",
        "media3-exoplayer-integration",
        "universal-build-system-commands"
      ]
    }
  },
  
  "project_patterns": {
    "ui_layer": {
      "composables": "Screen, Dialog, Card, Item composables with state hoisting",
      "viewmodels": "HiltViewModel with StateFlow/LiveData",
      "navigation": "Navigation Compose with type-safe arguments"
    },
    "data_layer": {
      "entities": "Room entities with proper relationships",
      "repositories": "Repository pattern with suspend functions",
      "dao": "Data Access Objects with Flow returns"
    },
    "domain_layer": {
      "use_cases": "Single responsibility use cases",
      "models": "Domain models separate from data entities"
    }
  },
  
  "build_system_context": {
    "type": "universal-build-system",
    "commands": {
      "info": "./build-scripts/universal-build.sh info",
      "build": "./build-scripts/simple-build.sh build",
      "test": "./gradlew testDebugUnitTest",
      "diagnose": "./gradlew diagnose"
    },
    "multi_architecture": true,
    "auto_aapt2_fixes": true
  },
  
  "team_learning": {
    "common_completions": [
      {
        "trigger": "compose_screen",
        "completion": "@Composable\nfun ScreenName(\n    viewModel: ViewModel = hiltViewModel(),\n    onNavigate: () -> Unit\n) {\n    val uiState by viewModel.uiState.collectAsState()\n    \n    Column {\n        // UI content\n    }\n}"
      },
      {
        "trigger": "room_entity",
        "completion": "@Entity(tableName = \"table_name\")\ndata class EntityName(\n    @PrimaryKey val id: String = UUID.randomUUID().toString(),\n    val name: String,\n    val createdAt: Long = System.currentTimeMillis()\n)"
      },
      {
        "trigger": "hilt_viewmodel",
        "completion": "@HiltViewModel\nclass ViewModelName @Inject constructor(\n    private val repository: Repository\n) : ViewModel() {\n    \n    private val _uiState = MutableStateFlow(UiState())\n    val uiState: StateFlow<UiState> = _uiState.asStateFlow()\n}"
      }
    ]
  },
  
  "context_awareness": {
    "file_patterns": {
      "ui/**/*.kt": "jetpack_compose_patterns",
      "data/**/*.kt": "room_database_patterns", 
      "domain/**/*.kt": "business_logic_patterns",
      "di/**/*.kt": "hilt_injection_patterns"
    },
    "import_suggestions": {
      "compose": [
        "androidx.compose.runtime.*",
        "androidx.compose.ui.*",
        "androidx.compose.material3.*"
      ],
      "room": [
        "androidx.room.*",
        "kotlinx.coroutines.flow.Flow"
      ],
      "hilt": [
        "dagger.hilt.android.*",
        "javax.inject.*"
      ]
    }
  }
}