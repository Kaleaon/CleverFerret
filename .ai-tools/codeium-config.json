{
  "project_name": "CleverFerret Universal Media Library",
  "codeium_settings": {
    "language_preferences": ["kotlin", "java", "xml", "json"],
    "framework_awareness": [
      "android-jetpack-compose",
      "android-room",
      "android-hilt", 
      "android-media3",
      "material-design-3"
    ],
    "code_completion_context": "android-mvvm-architecture"
  },
  
  "project_context": {
    "type": "android-kotlin-mvvm",
    "build_system": "universal-build-system",
    "key_features": [
      "Multi-architecture APK generation",
      "Universal media library management", 
      "Calibre integration",
      "Modern Material 3 UI",
      "Multi-format media playback"
    ]
  },
  
  "intelligent_completions": {
    "compose_patterns": {
      "state_management": [
        "remember { mutableStateOf() }",
        "collectAsState()",
        "LaunchedEffect",
        "DisposableEffect"
      ],
      "ui_components": [
        "LazyColumn",
        "LazyRow", 
        "Card",
        "Button",
        "TextField",
        "TopAppBar"
      ]
    },
    "room_patterns": {
      "entities": [
        "@Entity(tableName = \"table_name\")",
        "@PrimaryKey",
        "@ColumnInfo(name = \"column_name\")"
      ],
      "dao_methods": [
        "@Query(\"SELECT * FROM table_name\")",
        "@Insert(onConflict = OnConflictStrategy.REPLACE)",
        "@Update",
        "@Delete"
      ]
    },
    "hilt_patterns": {
      "injection": [
        "@HiltViewModel",
        "@Inject constructor()",
        "@Module",
        "@InstallIn(SingletonComponent::class)"
      ]
    }
  },
  
  "build_system_integration": {
    "preferred_commands": [
      "./build-scripts/simple-build.sh build debug",
      "./build-scripts/universal-build.sh info",
      "./gradlew testDebugUnitTest"
    ],
    "architecture_awareness": true,
    "multi_arch_support": ["arm64-v8a", "x86_64", "armeabi-v7a", "x86"]
  },
  
  "code_style_preferences": {
    "kotlin_style": "official",
    "indentation": 4,
    "line_length": 120,
    "naming_conventions": {
      "classes": "PascalCase",
      "functions": "camelCase",
      "variables": "camelCase",
      "constants": "SCREAMING_SNAKE_CASE"
    }
  }
}