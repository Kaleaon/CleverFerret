{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Universal Build Info",
      "type": "shell",
      "command": "./build-scripts/universal-build.sh",
      "args": ["info"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Build Debug (Universal)",
      "type": "shell", 
      "command": "./build-scripts/simple-build.sh",
      "args": ["build", "debug"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": [
        "$gradle"
      ]
    },
    {
      "label": "Build Release (Universal)",
