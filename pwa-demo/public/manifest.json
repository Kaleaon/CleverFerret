{
  "id": "/",
  "name": "CleverFerret - Universal Media Library",
  "short_name": "CleverFerret",
  "description": "A comprehensive Universal Media Library for managing books, movies, music, and more",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "background_color": "#FFFBFE",
  "theme_color": "#6750A4",
  "orientation": "any",
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "categories": ["books", "entertainment", "lifestyle", "productivity"],
  "screenshots": [],
  "shortcuts": [
    {
      "name": "My Libraries",
      "short_name": "Libraries",
      "description": "View all your media libraries",
      "url": "/",
      "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "Import Calibre",
      "short_name": "Import",
      "description": "Import from Calibre library",
      "url": "/?action=import",
      "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96" }]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+cleverferret",
      "url": "/?url=%s"
    }
  ],
  "share_target": {
    "action": "/import",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/epub+zip",
            "application/pdf",
            "audio/mpeg",
            "video/mp4"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/import",
      "accept": {
        "application/epub+zip": [".epub"],
        "application/pdf": [".pdf"],
        "audio/mpeg": [".mp3"],
        "video/mp4": [".mp4"]
      }
    }
  ]
}