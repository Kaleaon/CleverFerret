{
  "id": "/",
  "name": "CleverFerret - Universal Media Library",
  "short_name": "CleverFerret",
  "description": "A comprehensive Universal Media Library for managing books, movies, music, and more",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "background_color": "#FFFBFE",
  "theme_color": "#6750A4",
  "orientation": "any",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "categories": ["books", "entertainment", "lifestyle", "productivity"],
  "screenshots": [],
  "shortcuts": [
    {
      "name": "My Libraries",
      "short_name": "Libraries",
      "description": "View all your media libraries",
      "url": "/",
      "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "Import Calibre",
      "short_name": "Import",
      "description": "Import from Calibre library",
      "url": "/?action=import",
      "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96" }]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+cleverferret",
      "url": "/?url=%s"
    }
  ],
  "share_target": {
    "action": "/import",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["application/epub+zip", "application/pdf", "audio/mpeg", "video/mp4"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/open",
      "accept": {
        "application/epub+zip": [".epub"],
        "application/x-mobipocket-ebook": [".mobi", ".azw", ".azw3"],
        "application/pdf": [".pdf"],
        "application/x-cbr": [".cbr"],
        "application/x-cbz": [".cbz"],
        "application/x-cbt": [".cbt"],
        "application/x-cb7": [".cb7"],
        "audio/mpeg": [".mp3"],
        "audio/mp4": [".m4a", ".m4b", ".aac"],
        "audio/flac": [".flac"],
        "audio/wav": [".wav"],
        "audio/ogg": [".ogg", ".opus"],
        "audio/x-ms-wma": [".wma"],
        "video/mp4": [".mp4"],
        "video/x-matroska": [".mkv"],
        "video/quicktime": [".mov"],
        "video/x-msvideo": [".avi"],
        "video/webm": [".webm"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/png": [".png"],
        "image/gif": [".gif"],
        "text/plain": [".txt", ".md", ".rtf"],
        "application/json": [".json"],
        "application/x-sqlite3": [".db", ".sqlite"]
      }
    }
  ]
}
